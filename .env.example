VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# OneMap routing token for commute times (services/routingService.js).
# Optional: the app prefers Firestore config/onemap { token }, which keeps the
# token out of the bundle and can be rotated without a redeploy. Tokens last
# ~3 days. Get one by POSTing email + password to
# https://www.onemap.gov.sg/api/auth/post/getToken
# Never put the OneMap account password here — it would ship to the browser.
VITE_ONEMAP_TOKEN=
