rules_version = '2';

// Covers User_Preferences (F-REQ-005/006/007), groups and the shared shortlist
// (F-REQ-008/009/016), the group's agreed preferences and preference ballots
// (F-REQ-010 to 013), listing votes (F-REQ-018) and enquiries (F-REQ-019).
// NOTE: any collection without a match block below is denied by default. Add a
// block when you add a collection rather than relaxing the rules globally.
service cloud.firestore {
  match /databases/{database}/documents {

    // Shared app configuration, e.g. the OneMap routing token (routingService.js).
    // Set by hand in the Firebase console: readable by signed-in users so the
    // token is not bundled into the client, and never writable from the app.
    match /config/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Housing_Listing — the rental corpus (F-REQ-014). Served from a bundled
    // JSON today (listings.js, USE_LOCAL), so this rule is not exercised yet;
    // it is here so that flipping that switch does not hand whoever does it a
    // silently empty Browse. The corpus is reference data: readable by any
    // signed-in user, never written from the client — it is loaded by the
    // import script with admin credentials.
    match /Housing_Listing/{listingId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Groups and the shared shortlist (F-REQ-008/009/016).
    match /groups/{groupId} {
      function memberIds() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }
      function isMember() {
        return request.auth != null && request.auth.uid in memberIds();
      }
      // The caller is the group's only member, so removing the group's data
      // cannot affect anybody else (leaveGroup's clean-up when the last member
      // leaves, and account deletion).
      function isLastMember() {
        return isMember() && memberIds().size() == 1;
      }

      // Membership updates may touch nothing but the membership fields. (Sizes
      // are not cross-checked: an older group whose lists were ever out of step
      // would otherwise be locked against every join and leave.)
      function onlyMembershipChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'members', 'memberCount', 'updatedAt']);
      }
      // joinGroupByInviteCode: a non-member appends exactly themselves.
      function isJoiningSelf() {
        return !(request.auth.uid in resource.data.memberIds)
          && request.resource.data.memberIds == resource.data.memberIds.concat([request.auth.uid])
          && request.resource.data.members[request.resource.data.members.size() - 1].id
            == request.auth.uid
          && onlyMembershipChanged();
      }
      // leaveGroup: a member removes exactly themselves.
      function isLeavingSelf() {
        return request.auth.uid in resource.data.memberIds
          && request.resource.data.memberIds == resource.data.memberIds.removeAll([request.auth.uid])
          && onlyMembershipChanged();
      }

      // Any signed-in user may read a group so joining by invite code works.
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.memberIds == [request.auth.uid];
      // Membership changes go through joinGroupByInviteCode / leaveGroup. This
      // used to be `request.auth != null`, which let any signed-in user add
      // themselves to any group (and so read its shortlist, votes and
      // enquiries), remove other members, or rename it.
      allow update: if request.auth != null && (isJoiningSelf() || isLeavingSelf());
      // Only the last member, as they leave.
      allow delete: if isLastMember();

      // groups/{groupId}/shortlist/{listingId} — one doc per saved listing, so
      // two members saving the same property converge instead of duplicating.
      match /shortlist/{listingId} {
        allow read: if isMember();

        // The document ID is the ListingID, and addedBy must be the caller:
        // a member cannot attribute an entry to someone else.
        allow create: if isMember()
          && request.resource.data.listingId == listingId
          && request.resource.data.addedBy == request.auth.uid;

        // Any member may remove any entry; addedByName keeps it accountable.
        allow delete: if isMember();

        // Entries are add/remove only — no edits in place.
        allow update: if false;
      }

      // groups/{groupId}/votes/{uid} — one ballot per member, holding their
      // preference votes and ready flags (groupSummaryService.js). Not the same
      // thing as listingVotes below: these settle the group's search filters,
      // not which property to enquire about.
      match /votes/{uid} {
        allow read: if isMember();

        // A member writes only their own ballot. The document id is their uid,
        // so there is no way to file one under somebody else's name.
        // saveVote and saveReady both merge-write, so create and update are
        // allowed together.
        allow create, update: if isMember()
          && request.auth.uid == uid
          && request.resource.data.UserID == uid;

        // Your own ballot (removed when you leave), or anyone's when the last
        // member deletes the group.
        allow delete: if (isMember() && request.auth.uid == uid) || isLastMember();
      }

      // groups/{groupId}/listingVotes/{uid}_{listingId} — one vote per member
      // per listing (groupShortlistService.js).
      match /listingVotes/{voteId} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.userId == request.auth.uid
          && voteId == request.auth.uid + '_' + request.resource.data.listingId;
        // Members can only withdraw their own vote, except that the last member
        // removes everything when the group is deleted.
        allow delete: if (isMember() && resource.data.userId == request.auth.uid)
          || isLastMember();
        allow update: if false;
      }

      // groups/{groupId}/enquiries/{listingId} — one enquiry per group per
      // listing (enquiryService.js, F-REQ-019), read as a whole collection.
      //
      // This used to be a top-level `enquiries` collection read by a query on
      // groupId, with the rule calling get() on the group to check membership.
      // Firestore evaluates a list query against the rule before it runs and
      // cannot verify a get(), so that query is refused however correct the
      // rule looks. Under the group, the path proves membership on its own.
      match /enquiries/{listingId} {
        allow read: if isMember();
        allow create: if isMember()
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.listingId == listingId;
        // Submitted enquiries are final, until the group itself is deleted.
        allow update: if false;
        allow delete: if isLastMember();
      }
    }

    // Group_Preferences/{groupId} — the group's agreed search filters plus each
    // member's priority ranking (groupPreferencesService.js, F-REQ-013). The
    // document id is the group id, so membership is checked against it directly.
    match /Group_Preferences/{groupId} {
      function isMember() {
        return request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds;
      }

      allow read: if isMember();

      // Any member may settle the group's preferences, but the document must
      // name the group it lives under and record who wrote it.
      allow create, update: if isMember()
        && request.resource.data.GroupID == groupId
        && request.resource.data.UpdatedBy == request.auth.uid;

      // The agreed preferences live as long as the group does, and go with it
      // when its last member leaves.
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/groups/$(groupId)).data.memberIds
          == [request.auth.uid];
    }

    match /User_Preferences/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      // Any signed-in user can read the main doc (group aggregation needs it).
      // When IsBudgetPrivate is true the budget fields here are null, so only
      // users who chose to share their budget are included in group summaries.
      allow read: if request.auth != null;

      // Only the owner can write, and a private budget can never leak into
      // the shared doc.
      allow create, update: if isOwner()
        && request.resource.data.UserID == uid
        && (request.resource.data.IsBudgetPrivate == false
          || (request.resource.data.BudgetMin == null
            && request.resource.data.BudgetMax == null));

      allow delete: if isOwner();

      // User_Preferences/{uid}/Private/Budget: owner-only, always.
      match /Private/{docId} {
        allow read, write: if isOwner();
      }
    }
  }
}
